---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 - Không tìm thấy trang | Bách Thảo Ngân</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="https://bachthaongan.com.vn/wp-content/uploads/2025/09/cropped-870f64d6-efa7-40b0-8fb7-e1e767478610-scaled-1-32x32.png" sizes="32x32" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700&family=Quicksand:wght@500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header />

    <main class="error-container">
      <div class="error-card">
        <span class="error-code">404</span>
        <h1>Trang không tồn tại</h1>
        <p>Đường dẫn bạn yêu cầu không khả dụng hoặc đã được thay đổi.</p>
        <div class="action-buttons">
          <a href="./index.html" class="btn primary">Về trang Catalog</a>
          <a href="https://bachthaongan.com.vn/" class="btn secondary">Về trang chủ Bách Thảo Ngân</a>
        </div>
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
  :root {
    --primary: #cba051;
    --navy-dark: #1a354f;
    --bg-light: #f8fafc;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: "Quicksand", sans-serif;
    background-color: var(--bg-light);
    color: var(--navy-dark);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .error-container {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
  }

  .error-card {
    text-align: center;
    max-width: 500px;
    background: #ffffff;
    padding: 3rem 2rem;
    border-radius: 16px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
    border: 1px solid #e2e8f0;
  }

  .error-code {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 5rem;
    font-weight: 800;
    color: var(--primary);
    line-height: 1;
    display: block;
    margin-bottom: 1rem;
  }

  h1 {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  p {
    color: #64748b;
    margin-bottom: 2rem;
  }

  .action-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    padding: 0.75rem 1.25rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn.primary {
    background: var(--navy-dark);
    color: #ffffff;
  }

  .btn.primary:hover {
    background: #071c25;
  }

  .btn.secondary {
    background: #e2e8f0;
    color: var(--navy-dark);
  }

  .btn.secondary:hover {
    background: #cbd5e1;
  }
</style>

---
import Header from './Header.astro';
import Footer from './Footer.astro';
import PdfViewer from './PdfViewer.astro';
import { site } from '../config/seo';

interface Props {
  lang: 'vi' | 'en';
}

const { lang } = Astro.props;
const seo = site.seo[lang];

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const alternateUrl = new URL(lang === 'vi' ? 'en/' : '', Astro.site).toString();
const defaultUrl = new URL('', Astro.site).toString();

const cfAnalyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;

const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: site.name,
      url: defaultUrl,
      inLanguage: lang,
      publisher: { '@type': 'Organization', name: site.name, url: defaultUrl },
    },
    {
      '@type': 'Organization',
      name: site.name,
      url: defaultUrl,
      telephone: site.phone,
      email: site.email,
      logo: site.appleTouchIcon,
      address: { '@type': 'PostalAddress', ...site.address },
      sameAs: [site.social.facebook],
    },
    {
      '@type': 'TouristAttraction',
      name: site.name,
      description: seo.pageDesc,
      url: canonicalUrl,
      image: site.ogImage,
      telephone: site.phone,
      address: { '@type': 'PostalAddress', ...site.address },
      sameAs: [site.social.facebook],
    },
  ],
});
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{seo.pageTitle}</title>
    <meta name="description" content={seo.pageDesc} />
    <meta name="keywords" content={seo.keywords.join(', ')} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="vi" href={defaultUrl} />
    <link rel="alternate" hreflang="en" href={alternateUrl} />
    <link rel="alternate" hreflang="x-default" href={defaultUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:locale" content={seo.ogLocale} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={seo.pageTitle} />
    <meta property="og:description" content={seo.pageDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={site.ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.pageTitle} />
    <meta name="twitter:description" content={seo.pageDesc} />
    <meta name="twitter:image" content={site.ogImage} />

    <!-- Favicons -->
    <link rel="icon" href={site.favicon} sizes="32x32" />
    <link rel="apple-touch-icon" href={site.appleTouchIcon} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet" />

    {lang === 'vi' && (
      <script is:inline>
        new URLSearchParams(location.search).get('lang') === 'en' && location.replace('./en/index.html');
      </script>
    )}

    {cfAnalyticsToken && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token":"${cfAnalyticsToken}"}`}></script>
    )}

    <!-- Schema.org Structured Data (JSON-LD) -->
    <script is:inline type="application/ld+json" set:html={structuredData}></script>
  </head>
  <body>
    <Header lang={lang} />

    <main class="main-content">
      <PdfViewer
        pdfUrlVi={site.pdf.vi}
        pdfUrlEn={site.pdf.en}
        initialLang={lang}
      />
    </main>

    <Footer />
  </body>
</html>

<style>
  :root {
    --primary: #cba051;
    --primary-hover: #b88d3e;
    --navy-dark: #1a354f;
    --navy-deep: #071c25;
    --text-dark: #1a354f;
    --bg-light: #f8fafc;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: "Quicksand", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: 500;
    background-color: var(--bg-light);
    color: var(--text-dark);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  .main-content {
    flex: 1;
    width: 100%;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
</style>

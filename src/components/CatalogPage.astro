---
import Header from './Header.astro';
import Footer from './Footer.astro';
import { site } from '../config/seo';

interface Props {
  lang: 'vi' | 'en';
}

const { lang } = Astro.props;
const seo = site.seo[lang];
const flipbookUrl = site.flipbooks[lang];

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const alternateUrl = new URL(lang === 'vi' ? 'en/' : '', Astro.site).toString();
const defaultUrl = new URL('', Astro.site).toString();

const cfAnalyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;

const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: site.name,
      url: defaultUrl,
      inLanguage: lang,
      publisher: { '@type': 'Organization', name: site.name, url: defaultUrl },
    },
    {
      '@type': 'Organization',
      name: site.name,
      url: defaultUrl,
      telephone: site.phone,
      email: site.email,
      logo: site.appleTouchIcon,
      address: { '@type': 'PostalAddress', ...site.address },
      sameAs: [site.social.facebook],
    },
    {
      '@type': 'TouristAttraction',
      name: site.name,
      description: seo.pageDesc,
      url: canonicalUrl,
      image: site.ogImage,
      telephone: site.phone,
      address: { '@type': 'PostalAddress', ...site.address },
      sameAs: [site.social.facebook],
    },
  ],
});
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{seo.pageTitle}</title>
    <meta name="description" content={seo.pageDesc} />
    <meta name="keywords" content={seo.keywords.join(', ')} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="vi" href={defaultUrl} />
    <link rel="alternate" hreflang="en" href={alternateUrl} />
    <link rel="alternate" hreflang="x-default" href={defaultUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:locale" content={seo.ogLocale} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={seo.pageTitle} />
    <meta property="og:description" content={seo.pageDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={site.ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.pageTitle} />
    <meta name="twitter:description" content={seo.pageDesc} />
    <meta name="twitter:image" content={site.ogImage} />

    <!-- Favicons -->
    <link rel="icon" href={site.favicon} sizes="32x32" />
    <link rel="apple-touch-icon" href={site.appleTouchIcon} />

    <!-- Tối ưu kết nối Heyzine & Fonts -->
    <link rel="preconnect" href="https://heyzine.com" crossorigin />
    <link rel="preconnect" href="https://cdnc.heyzine.com" crossorigin />
    <link rel="dns-prefetch" href="https://heyzine.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet" />

    {lang === 'vi' && (
      <script is:inline>
        new URLSearchParams(location.search).get('lang') === 'en' && location.replace('/en/');
      </script>
    )}

    {cfAnalyticsToken && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token":"${cfAnalyticsToken}"}`}></script>
    )}

    <!-- Schema.org Structured Data (JSON-LD) -->
    <script is:inline type="application/ld+json" set:html={structuredData}></script>
  </head>
  <body>
    <Header lang={lang} />

    <main class="main-content">
      <div class="viewer-container">
        <!-- Loading Skeleton -->
        <div class="viewer-skeleton" id="viewerSkeleton" aria-hidden="true">
          <div class="spinner"></div>
          <p>Đang tải Catalog...</p>
        </div>

        <iframe
          class="flipbook-frame active"
          src={flipbookUrl}
          title={lang === 'vi' ? "Catalog Bách Thảo Ngân (Tiếng Việt)" : "Catalog Bách Thảo Ngân (English)"}
          allow="clipboard-write; fullscreen"
          allowfullscreen="allowfullscreen"
        ></iframe>
      </div>
    </main>

    <Footer />

    <script>
      const frame = document.querySelector<HTMLIFrameElement>('.flipbook-frame');
      const skeleton = document.getElementById('viewerSkeleton');

      function hideSkeleton() {
        if (skeleton) {
          skeleton.style.opacity = '0';
          setTimeout(() => {
            skeleton.style.display = 'none';
          }, 300);
        }
      }

      if (frame) {
        frame.addEventListener('load', hideSkeleton);
        setTimeout(hideSkeleton, 2500);
      }
    </script>
  </body>
</html>

<style>
  :root {
    --primary: #cba051;
    --primary-hover: #b88d3e;
    --navy-dark: #1a354f;
    --navy-deep: #071c25;
    --text-dark: #1a354f;
    --bg-light: #f8fafc;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: "Quicksand", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: 500;
    background-color: var(--bg-light);
    color: var(--text-dark);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  .main-content {
    flex: 1;
    width: 100%;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .viewer-container {
    position: relative;
    width: 100%;
    flex: 1;
    min-height: calc(100vh - 80px);
    height: 90vh;
    border-radius: 0;
    overflow: hidden;
    background: #000;
    box-shadow: none;
  }

  .viewer-skeleton {
    position: absolute;
    inset: 0;
    background: #0f172a;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: #94a3b8;
    font-size: 0.9rem;
    z-index: 5;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .spinner {
    width: 36px;
    height: 36px;
    border: 3px solid rgba(203, 160, 81, 0.2);
    border-top-color: var(--primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .flipbook-frame {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 640px) {
    .viewer-container {
      min-height: calc(100vh - 70px);
      height: 85vh;
    }
  }
</style>

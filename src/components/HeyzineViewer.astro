---
interface Props {
  flipbookUrlVi?: string;
  flipbookUrlEn?: string;
  initialLang?: 'vi' | 'en';
}

const {
  flipbookUrlVi = 'https://heyzine.com/flip-book/4545e51740.html',
  flipbookUrlEn = 'https://heyzine.com/flip-book/0af751ff71.html',
  initialLang = 'vi'
} = Astro.props;
---

<div class="heyzine-root" id="heyzineRoot" data-url-vi={flipbookUrlVi} data-url-en={flipbookUrlEn} data-lang={initialLang}>
  <!-- Top Switcher & Action Bar -->
  <div class="heyzine-toolbar">
    <div class="toolbar-left">
      <span class="mode-badge">FLIPBOOK 3D</span>
      <span class="toolbar-title" id="heyzineTitle">
        {initialLang === 'vi' ? 'Catalog Bách Thảo Ngân (Lật trang 3D)' : 'Bach Thao Ngan Catalog (3D Flipbook)'}
      </span>
    </div>

    <div class="toolbar-right">
      <a href="/" class="mode-switch-btn" title="Chuyển sang chế độ cuộn dọc PDF">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        <span>Xem Cuộn Dọc PDF</span>
      </a>

      <a href={initialLang === 'en' ? flipbookUrlEn : flipbookUrlVi} target="_blank" rel="noopener noreferrer" class="action-btn" id="btnHeyzineFullscreen">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        <span>Toàn màn hình &nearr;</span>
      </a>
    </div>
  </div>

  <!-- Viewer Container -->
  <div class="heyzine-container">
    <div class="viewer-skeleton" id="heyzineSkeleton">
      <div class="spinner"></div>
      <p>Đang tải Flipbook 3D...</p>
    </div>

    <!-- Iframe Tiếng Việt -->
    <iframe
      id="frameVi"
      class={`flipbook-frame ${initialLang === 'vi' ? 'active' : ''}`}
      src={flipbookUrlVi}
      title="Catalog Bách Thảo Ngân (Tiếng Việt)"
      allow="clipboard-write; fullscreen"
      allowfullscreen="allowfullscreen"
      scrolling="no"
      frameborder="0"
    ></iframe>

    <!-- Iframe Tiếng Anh -->
    <iframe
      id="frameEn"
      class={`flipbook-frame ${initialLang === 'en' ? 'active' : ''}`}
      src={flipbookUrlEn}
      title="Catalog Bách Thảo Ngân (English)"
      allow="clipboard-write; fullscreen"
      allowfullscreen="allowfullscreen"
      scrolling="no"
      frameborder="0"
      loading="lazy"
    ></iframe>
  </div>
</div>

<script>
  const frameVi = document.getElementById('frameVi') as HTMLIFrameElement;
  const frameEn = document.getElementById('frameEn') as HTMLIFrameElement;
  const skeleton = document.getElementById('heyzineSkeleton');
  const title = document.getElementById('heyzineTitle');
  const btnFs = document.getElementById('btnHeyzineFullscreen') as HTMLAnchorElement;

  const urlVi = document.getElementById('heyzineRoot')?.getAttribute('data-url-vi') || '';
  const urlEn = document.getElementById('heyzineRoot')?.getAttribute('data-url-en') || '';

  function hideSkeleton() {
    if (skeleton) {
      skeleton.style.opacity = '0';
      setTimeout(() => {
        skeleton.style.display = 'none';
      }, 300);
    }
  }

  if (frameVi) frameVi.addEventListener('load', hideSkeleton);
  setTimeout(hideSkeleton, 2500);

  function setLanguage(lang: string) {
    const isEn = lang === 'en';
    if (isEn) {
      frameVi?.classList.remove('active');
      frameEn?.classList.add('active');
      if (title) title.textContent = 'Bach Thao Ngan Catalog (3D Flipbook)';
      if (btnFs) btnFs.href = urlEn;
    } else {
      frameEn?.classList.remove('active');
      frameVi?.classList.add('active');
      if (title) title.textContent = 'Catalog Bách Thảo Ngân (Lật trang 3D)';
      if (btnFs) btnFs.href = urlVi;
    }
  }

  window.addEventListener('catalog-lang-change', (event: any) => {
    setLanguage(event.detail.lang);
  });
</script>

<style>
  .heyzine-root {
    width: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
    background-color: #0b0f19;
  }

  .heyzine-toolbar {
    background-color: #1e293b;
    border-bottom: 1px solid #334155;
    padding: 0.5rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 48px;
    z-index: 10;
  }

  .toolbar-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .mode-badge {
    background: #cba051;
    color: #071c25;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 4px;
    letter-spacing: 0.5px;
  }

  .toolbar-title {
    color: #f1f5f9;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .toolbar-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .mode-switch-btn {
    background: rgba(203, 160, 81, 0.15);
    border: 1px solid rgba(203, 160, 81, 0.4);
    color: #cba051;
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.2s ease;
  }

  .mode-switch-btn:hover {
    background: #cba051;
    color: #071c25;
  }

  .action-btn {
    background: #0f172a;
    border: 1px solid #334155;
    color: #f1f5f9;
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.2s ease;
  }

  .action-btn:hover {
    background: #334155;
    color: #ffffff;
  }

  .heyzine-container {
    position: relative;
    width: 100%;
    flex: 1;
    min-height: calc(100vh - 128px);
    height: 88vh;
    background: #000000;
  }

  .viewer-skeleton {
    position: absolute;
    inset: 0;
    background: #0f172a;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: #94a3b8;
    font-size: 0.9rem;
    z-index: 5;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .spinner {
    width: 36px;
    height: 36px;
    border: 3px solid rgba(203, 160, 81, 0.2);
    border-top-color: #cba051;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .flipbook-frame {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.25s ease-in-out;
  }

  .flipbook-frame.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    z-index: 2;
  }

  @media (max-width: 640px) {
    .heyzine-toolbar {
      padding: 0.4rem 0.75rem;
    }

    .toolbar-title {
      display: none;
    }

    .heyzine-container {
      min-height: calc(100vh - 110px);
      height: 82vh;
    }
  }
</style>

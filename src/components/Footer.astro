<style>
  .site-footer {
    background-color: #071c25;
    color: #e2e8f0;
    font-size: 0.9rem;
    margin-top: auto;
  }

  .footer-main {
    padding: 3rem 1.5rem 2rem;
  }

  .footer-container {
    max-width: 1300px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: 2.5rem;
  }

  .footer-heading {
    color: #ffffff;
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 1rem;
    line-height: 1.4;
  }

  .col-heading {
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 1rem;
    position: relative;
    padding-bottom: 0.5rem;
  }

  .col-heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 35px;
    height: 2px;
    background: #cba051;
  }

  .contact-list,
  .link-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .contact-list li {
    margin-bottom: 0.6rem;
    line-height: 1.5;
    color: #cbd5e1;
  }

  .contact-list a,
  .link-list a {
    color: #cbd5e1;
    text-decoration: none;
    transition: color 0.2s;
  }

  .contact-list a:hover,
  .link-list a:hover {
    color: #cba051;
  }

  .link-list li {
    margin-bottom: 0.5rem;
  }

  .social-links {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    transition: all 0.2s ease;
  }

  .social-btn:hover {
    background: #cba051;
    border-color: #cba051;
    transform: translateY(-2px);
  }

  button.social-btn {
    background: transparent;
    padding: 0;
    font: inherit;
  }

  .social-btn[disabled] {
    opacity: 0.35;
    cursor: default;
  }

  .social-btn[disabled]:hover {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.2);
    transform: none;
  }

  .map-wrapper {
    border-radius: 8px;
    overflow: hidden;
    margin-top: 0.5rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
  }

  .footer-bottom {
    background-color: #023349;
    padding: 1rem 1.5rem;
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .footer-bottom p {
    margin: 0;
    font-size: 0.85rem;
    color: #94a3b8;
  }

  @media (max-width: 1024px) {
    .footer-container {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 640px) {
    .footer-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>

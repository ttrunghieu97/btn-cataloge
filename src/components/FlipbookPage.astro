---
import Header from './Header.astro';
import Footer from './Footer.astro';
import HeyzineViewer from './HeyzineViewer.astro';
import { site } from '../config/seo';

interface Props {
  lang: 'vi' | 'en';
}

const { lang } = Astro.props;
const seo = site.seo[lang];

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const alternateUrl = new URL(lang === 'vi' ? 'flipbook/en/' : 'flipbook/', Astro.site).toString();
const defaultUrl = new URL('flipbook/', Astro.site).toString();

const cfAnalyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{`Flipbook 3D – ${seo.pageTitle}`}</title>
    <meta name="description" content={`Xem chế độ Flipbook 3D lật trang: ${seo.pageDesc}`} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="vi" href={defaultUrl} />
    <link rel="alternate" hreflang="en" href={alternateUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:locale" content={seo.ogLocale} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`Flipbook 3D – ${seo.pageTitle}`} />
    <meta property="og:description" content={seo.pageDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={site.ogImage} />

    <!-- Favicons -->
    <link rel="icon" href={site.favicon} sizes="32x32" />
    <link rel="apple-touch-icon" href={site.appleTouchIcon} />

    <!-- Tối ưu kết nối Heyzine -->
    <link rel="preconnect" href="https://heyzine.com" crossorigin />
    <link rel="preconnect" href="https://cdnc.heyzine.com" crossorigin />
    <link rel="dns-prefetch" href="https://heyzine.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet" />

    {cfAnalyticsToken && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token":"${cfAnalyticsToken}"}`}></script>
    )}
  </head>
  <body>
    <Header lang={lang} />

    <main class="main-content">
      <HeyzineViewer initialLang={lang} />
    </main>

    <Footer />
  </body>
</html>

<style>
  :root {
    --primary: #cba051;
    --primary-hover: #b88d3e;
    --navy-dark: #1a354f;
    --navy-deep: #071c25;
    --text-dark: #1a354f;
    --bg-light: #f8fafc;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: "Quicksand", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: 500;
    background-color: var(--bg-light);
    color: var(--text-dark);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  .main-content {
    flex: 1;
    width: 100%;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
</style>
